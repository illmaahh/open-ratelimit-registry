{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RateLimitProviderSpec",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "source_url",
    "last_verified",
    "buckets",
    "retry",
    "examples"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "ai",
        "devtools",
        "payments",
        "messaging",
        "ecommerce",
        "crm",
        "cloud",
        "standard"
      ]
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "detect_headers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "enum": [
              "requests",
              "tokens",
              "input_tokens",
              "output_tokens",
              "points",
              "credits"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "triplet",
              "ratio",
              "ietf_structured"
            ]
          },
          "limit_header": {
            "type": "string"
          },
          "remaining_header": {
            "type": "string"
          },
          "reset_header": {
            "type": "string"
          },
          "reset_format": {
            "type": "string",
            "enum": [
              "epoch_seconds",
              "delta_seconds",
              "rfc3339",
              "duration_string",
              "none",
              "epoch_milliseconds"
            ]
          },
          "ratio_header": {
            "type": "string"
          },
          "structured_header": {
            "type": "string"
          },
          "policy_header": {
            "type": "string"
          }
        }
      }
    },
    "retry": {
      "type": "object",
      "required": [
        "status_codes",
        "strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "status_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          }
        },
        "retry_after_header": {
          "type": "string"
        },
        "retry_after_format": {
          "type": "string",
          "enum": [
            "seconds",
            "http_date",
            "none"
          ]
        },
        "strategy": {
          "type": "string",
          "enum": [
            "honor_retry_after",
            "wait_until_reset",
            "exponential_backoff_jitter"
          ]
        },
        "default_backoff_ms": {
          "type": "integer",
          "minimum": 100
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "description",
          "status",
          "headers",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected": {
            "type": "object",
            "required": [
              "is_limited"
            ],
            "properties": {
              "is_limited": {
                "type": "boolean"
              },
              "limit": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "remaining": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "retry_after_ms": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
