    "discord": {
      "id": "discord",
      "name": "Discord REST API",
      "category": "messaging",
      "source_url": "https://docs.discord.com/developers/topics/rate-limits",
      "last_verified": "2026-11-23",
      "detect_headers": [
        "x-ratelimit-bucket",
        "x-ratelimit-reset-after"
      ],
      "buckets": [
        {
          "name": "route",
          "unit": "requests",
          "format": "triplet",
          "limit_header": "x-ratelimit-limit",
          "remaining_header": "x-ratelimit-remaining",
          "reset_header": "x-ratelimit-reset-after",
          "reset_format": "delta_seconds"
        }
      ],
      "retry": {
        "status_codes": [
          429
        ],
        "retry_after_header": "retry-after",
        "retry_after_format": "seconds",
        "strategy": "honor_retry_after",
        "default_backoff_ms": 5000,
        "notes": "Per-route buckets use X-RateLimit-Bucket; 401/403/429 count toward Cloudflare invalid-request bans."
      },
      "examples": [
        {
          "description": "Discord per-route rate limit headers",
          "status": 200,
          "headers": {
            "x-ratelimit-bucket": "9852e1a53c06ffc5a89d65fef85ca4ce",
            "x-ratelimit-limit": "5",
            "x-ratelimit-remaining": "4",
            "x-ratelimit-reset-after": "15"
          },
          "expected": {
            "is_limited": false,
            "limit": 5,
            "remaining": 4,
            "retry_after_ms": null
          }
        },
        {
          "description": "Discord 429 rate limited response",
          "status": 429,
          "headers": {
            "x-ratelimit-bucket": "1d3c67957bcdccc6709861c232df8529",
            "x-ratelimit-limit": "5",
            "x-ratelimit-remaining": "0",
            "retry-after": "3"
          },
          "expected": {
            "is_limited": true,
            "limit": 5,
            "remaining": 0,
            "retry_after_ms": 3000
          }
        }
      ]
    },
